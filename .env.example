# Chép thành .env rồi sửa. Mọi biến đều có giá trị mặc định chạy được trên máy, không cần khóa ngoài.

# Backend
BACKEND_PORT=8000
# Postgres của compose mở ra host ở POSTGRES_PORT (mặc định 5433 để không đụng Postgres cài sẵn).
POSTGRES_PORT=5433
DATABASE_URL=postgres://xdi:xdi@localhost:5433/xdi
DATA_DIR=./data
JWT_SECRET=doi-gia-tri-nay-truoc-khi-dua-ra-ngoai
RUST_LOG=info

# Mô hình ngôn ngữ: mock | gemini | ollama
# mock: trả lời các câu hỏi mẫu của dataset mẫu, không gọi ra ngoài.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Google OAuth, tùy chọn, chưa dùng: để dành cho phần đăng nhập.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend, chưa dùng: để dành cho giao diện.
NEXT_PUBLIC_API_URL=http://localhost:8000
