# Chép thành .env rồi sửa. Mọi biến đều có giá trị mặc định chạy được trên máy, không cần khóa ngoài. docker compose
# đọc file này; backend chạy bằng make dev hay chạy binary trực tiếp thì không đọc .env, đặt biến trên dòng lệnh
# (docs/INSTALL.md mục 2).

# Bản chạy thật trên máy chủ (docs/INSTALL.md mục 3): bỏ dấu # ở ba dòng dưới và điền giá trị. COMPOSE_FILE thêm
# docker-compose.prod.yml: Postgres không mở cổng ra host, backend chỉ nghe 127.0.0.1, bắt buộc có hai biến sau.
# POSTGRES_PASSWORD chỉ chữ và số, ví dụ kết quả của openssl rand -hex 24. PUBLIC_URL bắt đầu bằng https:// thì cookie
# đăng nhập có cờ Secure.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# POSTGRES_PASSWORD=
# PUBLIC_URL=https://du-lieu.example.com

# Build image backend: số tiến trình biên dịch song song, mỗi tiến trình cần khoảng 1 GiB RAM. Để trống: mọi nhân
# CPU. Máy ít RAM đặt bằng khoảng số GiB RAM còn trống (docs/INSTALL.md mục 6).
CARGO_BUILD_JOBS=

# Backend
BACKEND_PORT=8000
# Địa chỉ backend nghe trên máy host khi chạy compose. Để trống: mọi địa chỉ. Đặt 127.0.0.1 khi có reverse proxy
# (Caddy) trên cùng máy, để cổng HTTP thường không mở ra Internet.
BACKEND_BIND=
# Postgres của compose mở ra host ở POSTGRES_PORT (mặc định 5433 để không đụng Postgres cài sẵn).
POSTGRES_PORT=5433
# Compose tự đặt DATABASE_URL (theo POSTGRES_PASSWORD) và DATA_DIR=/data cho backend, không lấy hai dòng DATABASE_URL,
# DATA_DIR ở đây; chúng là giá trị mặc định khi chạy backend ngoài compose.
DATABASE_URL=postgres://xdi:xdi@localhost:5433/xdi
DB_MAX_CONNECTIONS=10
# Số giây (số nguyên dương) một request chờ lấy kết nối Postgres khi mọi kết nối đang bận; quá thì request nhận lỗi
# thay vì treo.
DB_ACQUIRE_TIMEOUT_SECS=5
DATA_DIR=./data
# Tổng dung lượng tối đa của một lần nạp file (MB).
MAX_UPLOAD_MB=200
RUST_LOG=info
# Thư mục giao diện đã build. Để trống: backend chỉ phục vụ API (khi dev dùng Vite ở cổng 5173).
# Image Docker đặt sẵn biến này.
STATIC_DIR=
# Dataset mẫu: khi thiết lập lần đầu tạo xong workspace đầu tiên, nạp SAMPLES_DIR/dataco.csv thành dataset DataCo kèm
# chỉ số mẫu (data/README.md). false: workspace đầu tiên để trống. Để trống SAMPLES_DIR: chạy bằng cargo run từ
# backend/ thì dùng ../data/samples; compose luôn dùng /samples (thư mục data/samples gắn vào container).
SEED_SAMPLE=true
SAMPLES_DIR=
# Đoạn trả lời ngắn cho câu hỏi thường: dùng lời mô hình viết lại cho phần giải thích (từ số đã tính, không từ dòng kết
# quả) khi lời đó qua bước kiểm số (docs/PRIVACY.md). false: đoạn trả lời luôn là câu khuôn do backend viết.
ANSWER_TEXT=true
# Phần giải thích của câu hỏi thường: mô hình viết lại các câu code đã tính (số đã tính, tên nhóm, tên kỳ; không gửi dòng
# kết quả nào). false: không gọi mô hình, phần giải thích chỉ có câu do code viết.
INSIGHT_TEXT=true

# Nguồn database (chụp bảng Postgres thành dataset, docs/DATA.md). Khóa mã hóa thông tin kết nối: 32 byte dạng base64,
# tạo bằng openssl rand -base64 32. Để trống: tính năng tắt. Đổi khóa thì các nguồn đã thêm phải thêm lại.
SOURCE_SECRET_KEY=
# Máy chủ database được phép thêm làm nguồn, cách nhau bằng dấu phẩy (ví dụ db.example.com,10.0.0.5). Để trống: không
# thêm được nguồn nào, để backend không bị dùng dò máy trong mạng nội bộ.
SOURCE_ALLOWED_HOSTS=
# Trần số dòng và thời gian (giây) của một lần chụp bảng; dung lượng theo MAX_UPLOAD_MB.
SOURCE_MAX_ROWS=1000000
SOURCE_TIMEOUT_SECS=300

# Mô hình ngôn ngữ: mock | gemini | ollama
# mock: trả lời các câu hỏi mẫu của dataset mẫu, không gọi ra ngoài.
LLM_PROVIDER=mock
# Khóa lấy ở Google AI Studio. Thiếu khóa mà chọn gemini thì backend cảnh báo khi khởi động và báo lỗi khi hỏi.
GEMINI_API_KEY=
# Khóa Gemini riêng cho lệnh đánh giá (xdi-backend eval, eval-classify), để không chung hạn mức với GEMINI_API_KEY.
# Không đặt thì lệnh đánh giá dùng GEMINI_API_KEY. Makefile không đọc .env: chạy make thì đặt biến trên dòng lệnh.
EVAL_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Thời gian tối đa (giây) cho một lần gọi mô hình. Ollama chạy trên CPU chậm hơn Gemini nhiều nên mặc định dài hơn.
GEMINI_TIMEOUT_SECS=60
# Để trống: chạy compose thì dùng http://host.docker.internal:11434 (Ollama trên máy host), chạy bằng cargo run thì
# dùng http://localhost:11434. Đặt localhost ở đây thì backend trong container gọi vào chính nó, không tới được Ollama.
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECS=300
# Thời gian tối đa (giây) của bước phân loại câu hỏi (câu thường hay câu hỏi tìm nguyên nhân), chạy trước bước viết SQL.
# Quá mức này thì dùng luật từ khóa và câu hỏi chạy tiếp. Không dài hơn timeout của nhà cung cấp ở trên.
CLASSIFY_TIMEOUT_SECS=15
# Cửa sổ ngữ cảnh (token) gửi Ollama trong options.num_ctx, gồm prompt và câu trả lời. Nhỏ quá thì Ollama cắt phần đầu
# prompt (phần luật) mà không báo; lớn hơn thì Ollama cần thêm RAM (docs/INSTALL.md, mục 1).
OLLAMA_NUM_CTX=12288
# Thời gian tối đa (giây) một câu SQL của câu hỏi chạy trên DuckDB; quá thì câu bị dừng và người hỏi nhận lời báo.
# Phần DuckDB tính trước khi chạy thì không dừng được (docs/GUARD.md, mục Hạn chế đã biết).
QUERY_TIMEOUT_SECS=30
# Trần số dòng guard đặt cho SQL của câu hỏi. Giao diện chỉ nhận 1000 dòng đầu; số dòng đầy đủ đếm tới trần này.
ASK_MAX_ROWS=100000

# Google OAuth, tùy chọn, chưa dùng: để dành cho phần đăng nhập.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

