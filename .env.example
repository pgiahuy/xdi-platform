# Chép thành .env rồi sửa. Mọi biến có giá trị mặc định chạy được trên máy, không cần khóa ngoài. Ý nghĩa từng biến:
# docs/INSTALL.md, mục 1, Cấu hình. docker compose đọc file này; make dev và binary chạy trực tiếp thì không, đặt biến
# trên dòng lệnh (docs/INSTALL.md mục 2).

# Bản chạy thật trên máy chủ (docs/INSTALL.md mục 3): bỏ dấu # ở ba dòng dưới và điền giá trị. POSTGRES_PASSWORD chỉ
# chữ và số, ví dụ kết quả của openssl rand -hex 24.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# POSTGRES_PASSWORD=
# PUBLIC_URL=https://du-lieu.example.com

# Số tiến trình biên dịch khi build image, mỗi tiến trình cần khoảng 1 GiB RAM. Trống: mọi nhân CPU.
CARGO_BUILD_JOBS=

# Backend
BACKEND_PORT=8000
# Địa chỉ backend nghe trên máy host khi chạy compose. Trống: mọi địa chỉ; 127.0.0.1 khi có reverse proxy cùng máy.
BACKEND_BIND=
# Cổng Postgres của ứng dụng mở ra máy host.
POSTGRES_PORT=5433
# Compose tự đặt DATABASE_URL và DATA_DIR=/data cho backend; hai dòng dưới chỉ dùng khi chạy backend ngoài compose.
DATABASE_URL=postgres://xdi:xdi@localhost:5433/xdi
DB_MAX_CONNECTIONS=10
# Số giây một request chờ kết nối Postgres khi mọi kết nối đang bận.
DB_ACQUIRE_TIMEOUT_SECS=5
DATA_DIR=./data
# Tổng dung lượng tối đa của một lần nạp file (MB).
MAX_UPLOAD_MB=200
RUST_LOG=info
# Thư mục giao diện đã build. Trống: backend chỉ phục vụ API. Image Docker đặt sẵn.
STATIC_DIR=
# Thiết lập lần đầu nạp dữ liệu mẫu: các database mẫu nếu tới được, không thì SAMPLES_DIR/dataco.csv. false: workspace
# đầu tiên trống. SAMPLES_DIR trống: cargo run dùng ../data/samples, compose luôn dùng /samples.
SEED_SAMPLE=true
SAMPLES_DIR=
# Database mẫu, cách nhau bằng dấu phẩy, mỗi database một dataset. Không đặt: compose dùng sales_demo và edu_demo của
# demo-db, make dev dùng hai database đó ở 127.0.0.1:DEMO_DB_PORT. Bỏ dấu # ở dòng dưới để không thử kết nối.
# SAMPLE_DATABASE_URL=
# Cổng database mẫu trên 127.0.0.1 của máy host (data/postgres-demo/docker-compose.yml).
DEMO_DB_PORT=5440
# Đoạn trả lời ngắn của câu hỏi số liệu dùng lời giải thích đã qua kiểm số và kiểm nghĩa. false: luôn là câu khuôn.
ANSWER_TEXT=true
# Mô hình viết lời giải thích cho câu hỏi số liệu từ các con số code đã tính. false: chỉ câu do code viết.
INSIGHT_TEXT=true

# Nguồn database (docs/DATA.md). Khóa mã hóa thông tin kết nối, tạo bằng openssl rand -base64 32. Trống: backend tự
# sinh và lưu ở DATA_DIR/source_secret.key; mất file đó là mất mật khẩu các nguồn. Bản chạy thật nên đặt.
SOURCE_SECRET_KEY=
# Máy chủ database được phép thêm làm nguồn, cách nhau bằng dấu phẩy. Trống: không thêm được nguồn nào, trừ đúng máy
# và cổng của SAMPLE_DATABASE_URL.
SOURCE_ALLOWED_HOSTS=
# Trần của một lần chụp theo dung lượng Postgres báo (MB, chưa nén): một bảng, cả lần; bảng quá trần chỉ lưu cấu trúc.
# SOURCE_TIMEOUT_SECS: thời gian (giây) của cả bước chép. Số đo ở docs/PERFORMANCE.md.
SOURCE_TABLE_MAX_MB=2048
SOURCE_SNAPSHOT_MAX_MB=4096
SOURCE_TIMEOUT_SECS=300
# Trần số dòng của một bảng; trống là không có trần dòng (mặc định).
SOURCE_MAX_ROWS=
# Chụp lại mọi nguồn database mỗi N giờ; trống hay 0 là tắt.
SOURCE_RESNAPSHOT_HOURS=
# direct: DuckDB đọc thẳng Postgres bằng extension postgres; copy: Postgres COPY ra CSV tạm. Extension không nạp được
# thì tự dùng copy.
SOURCE_SNAPSHOT_MODE=direct
# File extension postgres của DuckDB. Trống: đường dẫn mặc định, image Docker có sẵn file; make dev tự trỏ tới
# duckdb-extensions/.
SOURCE_POSTGRES_EXTENSION=

# Mô hình ngôn ngữ: mock | gemini | ollama. mock chỉ trả lời các câu mẫu của dữ liệu mẫu, không gọi ra ngoài.
LLM_PROVIDER=mock
# Khóa lấy ở Google AI Studio.
GEMINI_API_KEY=
# Khóa Gemini cho mọi lệnh xdi-backend eval* (eval, eval-classify, eval-judge, eval-lessons), để không chung hạn mức với
# GEMINI_API_KEY; server không đọc. Không đặt: dùng GEMINI_API_KEY. Make không đọc .env: đặt trên dòng lệnh.
EVAL_GEMINI_API_KEY=
# Khóa dự phòng, tùy chọn: khóa chính hết hạn mức (lỗi 429) thì backend gọi lại bằng khóa này trong cùng lần gọi.
GEMINI_BACKUP_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Thời gian tối đa (giây) một lần gọi mô hình.
GEMINI_TIMEOUT_SECS=60
# Trống: compose dùng http://host.docker.internal:11434 (Ollama trên máy host), cargo run dùng http://localhost:11434.
# Đặt localhost ở đây thì backend trong container gọi vào chính nó.
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECS=300
# Thời gian tối đa (giây) của bước phân loại câu hỏi; quá thì dùng luật từ khóa. Không dài hơn timeout ở trên.
CLASSIFY_TIMEOUT_SECS=15
# Số lượt lập hồ sơ cột chạy cùng lúc, mỗi lượt ba prompt song song. Cao hơn thì dễ gặp lỗi 429 với gói miễn phí.
SEMANTIC_JOBS=2
# Cửa sổ ngữ cảnh (token) gửi Ollama. Nhỏ quá thì Ollama cắt phần đầu prompt mà không báo.
OLLAMA_NUM_CTX=12288
# Thời gian tối đa (giây) một câu SQL của câu hỏi chạy trên DuckDB (docs/GUARD.md, mục Hạn chế đã biết).
QUERY_TIMEOUT_SECS=30
# Trần số dòng guard đặt cho SQL của câu hỏi; giao diện nhận 1000 dòng đầu.
ASK_MAX_ROWS=100000

# Để dành cho đăng nhập bằng Google; backend chưa đọc.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
